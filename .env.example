# Core production settings
APP_ENV=production
DEBUG=False
SECRET_KEY=replace-with-at-least-50-random-characters
DATABASE_URL=postgresql://user:password@database.example.com:25060/yalla?sslmode=require
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://dashboard.example.com
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
DEPLOYMENT_REVISION=git-commit-or-release-id

# HTTPS and browser security
SECURE_HSTS_SECONDS=31536000

# Media storage
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Authentication email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=Yalla Market <no-reply@example.com>

# Push notifications. Configure exactly one service-account source.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Backend-only geocoding
GEOAPIFY_API_KEY=replace-with-backend-only-key
GEOAPIFY_CONNECT_TIMEOUT=3
GEOAPIFY_READ_TIMEOUT=5

# Distributed rate limiting. Production startup requires enforce + Redis.
RATE_LIMIT_MODE=enforce
RATE_LIMIT_REDIS_URL=rediss://user:password@redis.example.com:6379/1

# Optional during a staged rollout. Empty means every configured scope.
# RATE_LIMIT_ENFORCE_SCOPES=login_ip,login_identifier,admin_login_ip,admin_login_identifier,signup_ip,signup_email,otp_send_ip,otp_send_identifier,otp_verify_ip,otp_verify_identifier,refresh_ip,refresh_token,order_create_user,upload_user,notification_send_user,geocoding_user,geocoding_global

# Match the trusted ingress. The header is accepted only from these networks.
RATE_LIMIT_CLIENT_IP_HEADER=DO-Connecting-IP
RATE_LIMIT_TRUSTED_PROXY_CIDRS=10.0.0.0/8
RATE_LIMIT_KEY_SECRET=replace-with-a-separate-long-random-secret
RATE_LIMIT_EXEMPT_PATHS=/health/,/healthz/,/readyz/
RATE_LIMIT_CONNECT_TIMEOUT=0.5
RATE_LIMIT_SOCKET_TIMEOUT=0.2
RATE_LIMIT_MAX_CONNECTIONS=20
RATE_LIMIT_HEALTH_CHECK_INTERVAL=30
RATE_LIMIT_LOG_SAMPLE_RATE=0.1

# Optional per-scope overrides
# RATE_LIMIT_LOGIN_IDENTIFIER_RATES=5/5m,20/1h
# RATE_LIMIT_API_USER_RATES=600/5m
# RATE_LIMIT_GEOCODING_USER_RATES=30/1m
# RATE_LIMIT_GEOCODING_GLOBAL_RATES=4/1s
