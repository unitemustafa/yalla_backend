COMPOSE_PROJECT_NAME=yalla
BACKEND_ENV_FILE=.env.production
DOMAIN=example.com
YALLA_DATA_ROOT=/srv/yalla
YALLA_BACKUP_ROOT=/srv/yalla/backups
BACKEND_IMAGE=yalla-backend:latest
POSTGRES_PASSWORD=replace-with-a-long-random-password

SECRET_KEY=replace-with-a-unique-random-value-of-at-least-50-characters
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://example.com
RATE_LIMIT_MODE=off
PUSH_DELIVERY_ASYNC=False
API_CACHE_ENABLED=False

# deploy/production-up.sh sets this automatically from the checked-out Git commit.
DEPLOYMENT_REVISION=unknown
DJANGO_LOG_LEVEL=INFO
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
AUTH_OTP_INCLUDE_IN_RESPONSE=False

FIREBASE_SERVICE_ACCOUNT_BASE64=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-your-brevo-smtp-login
EMAIL_HOST_PASSWORD=replace-with-your-brevo-smtp-key
DEFAULT_FROM_EMAIL=replace-with-an-address-verified-in-brevo
GEOAPIFY_API_KEY=
