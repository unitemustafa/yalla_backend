COMPOSE_PROJECT_NAME=yalla
BACKEND_ENV_FILE=.env.production
DOMAIN=example.com
YALLA_DATA_ROOT=/srv/yalla
BACKEND_IMAGE=yalla-backend:latest
POSTGRES_PASSWORD=replace-with-a-long-random-password

SECRET_KEY=replace-with-a-unique-random-value-of-at-least-50-characters
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://example.com
RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.30.0.0/24
RATE_LIMIT_KEY_SECRET=replace-with-an-independent-random-secret

DEPLOYMENT_REVISION=replace-with-a-release-or-git-sha
DJANGO_LOG_LEVEL=INFO
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
AUTH_OTP_INCLUDE_IN_RESPONSE=False

FIREBASE_SERVICE_ACCOUNT_BASE64=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
GEOAPIFY_API_KEY=
